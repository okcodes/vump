# Enforce LF line endings for all text files.
# Shell scripts and source files must not get CRLF on Windows checkout, since
# the same tree is built and executed on Linux and macOS.

* text=auto

*.sh        text eol=lf
*.rs        text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.cs        text eol=lf
*.csproj    text eol=lf
*.js        text eol=lf

# The sandbox exists to be read and experimented with, not to describe what
# this repository is written in.
sandbox/** linguist-vendored
