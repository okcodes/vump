# Where the site will be served from. Both values are read at build time.
#
# VITE_BASE_PATH is the path every asset URL is prefixed with: "/" for a custom
# domain at the root, "/vump/" for a GitHub project site at okcodes.github.io.
# VITE_SITE_URL is the absolute origin used for canonical and social-card URLs.
VITE_BASE_PATH=/
VITE_SITE_URL=https://okcodes.github.io/vump
